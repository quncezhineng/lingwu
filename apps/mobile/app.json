{
  "expo": {
    "name": "LingWu",
    "slug": "lingwu",
    "scheme": "lingwu",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.lingwu.mobile" },
    "android": { "package": "app.lingwu.mobile" },
    "web": {
      "bundler": "metro",
      "name": "LingWu — Your personal investment research agent",
      "lang": "zh",
      "themeColor": "#3a83f7",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
